{
  "name": "vidyavarta",
  "version": "1.0.0",
  "private": true,
  "description": "Local-first campus communication and classroom workflow application.",
  "main": "out/main/index.js",
  "scripts": {
    "dev:web": "vite --config vite.web.config.ts",
    "build:web": "vite build --config vite.web.config.ts",
    "preview:web": "vite preview --config vite.web.config.ts",
    "start": "npm run dev:live",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck:campus": "tsc -p tsconfig.campus.json",
    "typecheck": "npm run typecheck:web && npm run typecheck:campus",
    "setup:web": "npm rebuild better-sqlite3",
    "test": "tsx --test tests/campus*.test.ts tests/brain.test.ts tests/auth-core.test.ts tests/email-core.test.ts tests/env.test.ts tests/live-mode.test.ts",
    "test:e2e": "playwright test",
    "campus:api": "node tools/campus-agent.mjs",
    "package:node24": "npm run build:web && node tools/package-node24.mjs",
    "dev:live": "vite --config vite.web.config.ts"
  },
  "dependencies": {
    "better-sqlite3": "^12.11.1",
    "cheerio": "^1.0.0",
    "lucide-react": "^1.47.0",
    "nodemailer": "^10.0.10",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.7.5",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.2",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^5.6.3",
    "vite": "^5.4.8"
  }
}
